[Unit]
Description=Argon ONE/EON case daemon (fan control, power button, web UI)
After=multi-user.target network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/argonone-rs SERVICE
Restart=on-failure
RestartSec=5

# SQLite database (users/settings/fan curves/audit log, A§2.3) lives here.
# systemd creates this directory (owned by whatever User= below runs as)
# before every start — no manual `mkdir`/`chown` needed in an install
# script (A§3.2, A§4.2).
StateDirectory=argonone-rs
StateDirectoryMode=0750

# Dedicated system account (A§4.1's "Option A") instead of root — raw
# I2C + GPIO character-device access only needs group membership, not
# a privileged user (W§1.4). `dialout` covers both (packaging/udev/
# 60-argonone-i2c.rules puts /dev/i2c-1 there too, matching Ubuntu's
# own GPIO chardev group). `systemd-journal` is what the log viewer
# page (v0.7.0, W§3.8) needs to read this unit's own journal entries —
# without it, `journalctl -u argonone-rs` run as `argonone` sees
# nothing. The `argonone` account/group-membership itself is created
# by packaging/deb/postinst (.deb installs) or scripts/deploy-local.sh
# (manual installs) — this unit assumes it already exists by the time
# systemd tries to start as it.
User=argonone
SupplementaryGroups=dialout systemd-journal

[Install]
WantedBy=multi-user.target
